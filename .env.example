# QuantAI Guardian - Environment Variables

# Data Sources
TUSHARE_API_KEY=your_tushare_token
# 两次 Tushare 请求最小间隔（秒），约 0.35 ≈ 170 次/分钟
TUSHARE_MIN_INTERVAL_SEC=0.35
# 中证 A500 指数代码（Tushare）
TUSHARE_A500_INDEX_CODE=000510.SH
# A500 日线回溯自然日
A500_LOOKBACK_DAYS=400
# 自动加入自选时的备注
A500_WATCHLIST_NOTE=A500自动
# 是否启用工作日 18:20 定时 A500 同步
A500_SYNC_ENABLED=true
# 启动时自动初始化研究资产池
RESEARCH_UNIVERSE_BOOTSTRAP_ON_START=true
# 是否启用工作日指数 / ETF 增量同步
RESEARCH_UNIVERSE_SYNC_ENABLED=true
RESEARCH_UNIVERSE_SYNC_HOUR=18
RESEARCH_UNIVERSE_SYNC_MINUTE=5
# 首次或缺失数据时默认回补窗口
RESEARCH_SYNC_LOOKBACK_DAYS=400
# 增量同步时的重叠回补窗口
RESEARCH_SYNC_OVERLAP_DAYS=5
# 是否启用市场宽度日更
MARKET_BREADTH_SYNC_ENABLED=true
MARKET_BREADTH_SYNC_HOUR=18
MARKET_BREADTH_SYNC_MINUTE=12
MARKET_BREADTH_LOOKBACK_DAYS=120
AKSHARE_ENABLED=true
YFINANCE_RATE_LIMIT=200

# Local Storage Paths
QUANT_DATA_DIR=./data
QUANT_DB_PATH=./data/quant_platform.db
QUANT_LOG_DIR=./logs
QUANT_BACKUP_DIR=./backup

# Server Ports
API_PORT=8000
DASHBOARD_PORT=8501

# OpenClaw
OC_AUTO_MANAGEMENT=true
OC_AUTO_RECOVERY_ENABLED=true

# Notification (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CRITICAL_CHAT=
TELEGRAM_WARNING_CHAT=
TELEGRAM_REPORT_CHAT=

# Security
JWT_SECRET_KEY=change-me-to-a-random-string
ENCRYPTION_KEY=change-me-to-a-random-string
